# 服务器端口
PORT=3000

# 服务器域名或 IP（用于 CORS 和头像 URL）
HOST=your-domain.com

# 前端地址（用于 CORS 白名单）
FRONTEND_ORIGIN=http://your-domain.com

# 数据库文件路径（默认 api/data.db；可填绝对路径，或相对 api/ 目录的路径）
# 例：DB_PATH=/var/lib/easy2sound/data.db  或  DB_PATH=data/data.db
DB_PATH=

# 管理员用户名（逗号分隔），这些用户登录时自动提升为管理员
# 例：ADMIN_USERNAMES=QianSiqi,admin2
ADMIN_USERNAMES=

# ===== 邮箱验证码（注册功能，用 QQ 邮箱 SMTP 示例） =====
# QQ 邮箱需先在邮箱设置里开启 SMTP 服务并生成「授权码」
# （https://mail.qq.com → 设置 → 账户 → 开启 POP3/SMTP 服务）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的QQ邮箱授权码
# SMTP_FROM=可选，默认同 SMTP_USER
# SMTP_DEBUG=1   # 仅开发调试用：不真发信，把验证码放在接口响应里（切勿用于生产！）

# ===== Cloudflare Turnstile 人机验证（登录用） =====
# 1. 去 https://dash.cloudflare.com → Turnstile → Add site，域名填你的站点
# 2. 拿到两个密钥：
#    - 站点密钥（Site Key）→ 已填到前端 index.js 的 TURNSTILE_SITE_KEY
#    - 密钥（Secret Key）→ 填下面的 TURNSTILE_SECRET_KEY（在 Cloudflare 面板该 widget 页面可查看）
# 3. 不配置则登录不要求人机验证（开发模式）
TURNSTILE_SECRET_KEY=
# 可选：前端主机名白名单（逗号分隔），填你的正式域名即可，如 www.easy2sound.xyz
# 注意：生产环境不要包含 localhost / 127.0.0.1；不填则不做主机名校验
# TURNSTILE_HOSTNAMES=www.easy2sound.xyz
